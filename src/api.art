;--------------------------
; Type Definitions 
;--------------------------

define :message [
    init: method [role :string content :string][
        \role: role
        \content: content

        if not? in? \role ["user" "assistant"] ->
            throw.as: valueError "Message role must be 'user' or 'assistant'"
    ]
]

;--------------------------
; Helper Functions
;--------------------------

createMessage: function [role :string content :string][
    ;; description: « Create a new message object
    ;; returns: :message
    to :message [role content]
]

;--------------------------
; Main implementation
;--------------------------

define :claudeAPI [
    init: method [key :string][
        ;; options: [
        ;;     opus: :logical « use Claude Opus model
        ;;     haiku: :logical « use Claude Haiku model
        ;;     fable: :logical « use Claude Fable model
        ;; ]
        if null? key [ 
            throw.as: valueError "API key is required"
        ]
        if not? prefix? key "sk-" [
            throw.as: valueError "Invalid API key format - must start with 'sk-'"
        ]

        \apiKey: key
        \baseUrl: "https://api.anthropic.com"
        \apiVersion: "2026-10-21"
        \maxTokens: 16000
        
        \model: "claude-sonnet-5-5"
        if attr? 'opus  -> \model: "claude-opus-5-5"
        if attr? 'haiku -> \model: "claude-haiku-5-5"
        if attr? 'fable -> \model: "claude-fable-5-1"

        ; default parameters
        \effort: null
        \fallback: true
    ]

    chat: method [blk :block][
        ;; description: « Send a chat request to Claude's API
        ;; options: [
        ;;     model: :string « specify Claude model to use (default: claude-sonnet-5-5)
        ;;     system: :string « specify system message
        ;;     maxTokens: :integer « set max tokens for response
        ;;     effort: :string « set effort level (low, medium, high, xhigh, max)
        ;; ]
        ;; returns: :dictionary
        ;; example: {
        ;;     claude: to :claudeAPI ["sk-..."]!
        ;;     result: claude\chat [
        ;;         to :message ["user" "What is 2+2?"]
        ;;     ]
        ;;     print result\content
        ;; }

        ; Get parameters from attributes or defaults
        model: (attr 'model) ?? \model
        system: attr 'system
        maxTokens: (attr 'maxTokens) ?? \maxTokens
        effort: (attr 'effort) ?? \effort

        messages: @ blk
        ensure -> is? [:message] messages

        ; Build request body
        body: #[
            model: model
            messages: messages
            max_tokens: maxTokens
        ]

        if not? null? system [
            set body 'system system
        ]

        if not? null? effort [
            if not? in? effort ["low" "medium" "high" "xhigh" "max"] ->
                throw.as: valueError "Effort must be one of: low, medium, high, xhigh, max"
            set body 'output_config #[effort: effort]
        ]

        headers: #[
            "x-api-key": \apiKey
            "anthropic-version": \apiVersion
            "content-type": "application/json"
        ]

        ; Server-side fallback when a request is declined
        ; (only supported by some models)
        if and? [\fallback] [in? model ["claude-fable-5-1" "claude-opus-5-5" "claude-opus-5" "claude-sonnet-5-5"]][
            set headers "anthropic-beta" "server-side-fallback-2026-07-01"
            set body 'fallbacks "default"
        ]

        ; Make API request
        result: request.post 
            .json
            .headers: headers
            \baseUrl ++ "/v1/messages"
            body

        if result\status <> 200 [
            throw.as: runtimeError ~"API request failed with status |result\status|: |result\body|"
        ]

        return read.json result\body
    ]

    ask: method [question :string][
        ;; description: « Ask question directly to Claude API and get answer
        ;; returns: :string
        ;; example: {
        ;;     claude: to :claudeAPI ["sk-..."]!
        ;;     print claude\ask "What is the capital of Sweden?" 
        ;;     ; The capital of Sweden is Stockholm.
        ;; }
        response: \chat [
            createMessage "user" question
        ]

        unless key? response 'content ->
            throw "Something went wrong"

        if and? [key? response 'stop_reason] [response\stop_reason = "refusal"] ->
            throw "Request was declined by the model"

        ; Responses may also contain thinking blocks,
        ; so we only keep the text ones
        texts: select response\content 'block ->
            and? [key? block 'type] [block\type = "text"]

        if empty? texts ->
            throw "Non-text response generated"

        return join map texts 'block -> block\text
    ]

    setModel: method [model :string][
        ;; description: « Set default model
        \model: model
    ]

    setMaxTokens: method [tokens :integer][
        ;; description: « Set default max tokens
        \maxTokens: tokens
    ]

    setEffort: method [effort :string][
        ;; description: « Set default effort level (low, medium, high, xhigh, max)
        \effort: effort
    ]

    setFallback: method [enabled :logical][
        ;; description: « Enable/disable server-side model fallback on declined requests
        \fallback: enabled
    ]
]
